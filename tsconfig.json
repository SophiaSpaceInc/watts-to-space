{
  // Bun runs and bundles the TypeScript directly; tsc only type-checks (noEmit).
  // Based on Bun's recommended config for TypeScript 6+ (bun docs: guides/runtime/typescript).
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "types": ["bun"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Keep the model runnable by any type-stripping runtime (Node, Deno), not just Bun.
    "erasableSyntaxOnly": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": ["src", "test", "scripts"]
}
